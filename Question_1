using System;

namespace Lab1_AccessModifiers
{
    public class Student
    {
        public string Name = "Pankaj Sharma";

        private int Age = 22;

        protected string Department = "Computer Applications";

        internal double CGPA = 7.1;

        protected internal string College = "GLA University";

        private protected string Address = "Mathura";

        public void Display()
        {
            Console.WriteLine("Inside Student class:");
            Console.WriteLine("Name: " + Name);
            Console.WriteLine("Age: " + Age);
            Console.WriteLine("Department: " + Department);
            Console.WriteLine("CGPA: " + CGPA);
            Console.WriteLine("College: " + College);
            Console.WriteLine("Address: " + Address);
        }
    }
}
